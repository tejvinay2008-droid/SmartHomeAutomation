# Firebase Configuration for Google, Yahoo, and Email/Password Authentication
# Replace the placeholder values with your Firebase project configuration
# from the Firebase Console (https://console.firebase.google.com/):
# Project Settings > General > Your apps > Web app (</>)

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# OAUTH PROVIDER SETUP IN FIREBASE CONSOLE:
# 1. Google:
#    Go to Firebase Console > Build > Authentication > Sign-in method > Add new provider > Google.
#    Enable Google and configure the support email.
# 2. Yahoo:
#    Go to Firebase Console > Authentication > Sign-in method > Add new provider > Yahoo.
#    Follow instructions to add Yahoo Client ID and Client Secret from Yahoo Developer Network:
#    https://developer.yahoo.com/apps/
#    Callback URL to authorize in Yahoo Developer console:
#    https://<your-project-id>.firebaseapp.com/__/auth/handler
